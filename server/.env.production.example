NODE_ENV=production

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/risklens?retryWrites=true&w=majority
REDIS_URL=rediss://default:PASSWORD@HOST:6379

JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=risklens-api
JWT_AUDIENCE=risklens-web
REFRESH_TOKEN_EXPIRES_DAYS=7

COOKIE_SAME_SITE=none
# Leave COOKIE_DOMAIN empty for Vercel + Render unless both services use a shared parent custom domain.
# COOKIE_DOMAIN=.yourdomain.com

CLIENT_URL=https://risklens-client.vercel.app
CLIENT_URLS=
SERVER_URL=https://risklens-api-qn0e.onrender.com

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_FALLBACK=fallback

CACHE_TTL_SECONDS=45
CSV_BATCH_SIZE=500
