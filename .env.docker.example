# RiskLens Docker local defaults
# Copy this file to .env.docker before running docker compose.

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://mongo:27017/risklens
REDIS_URL=redis://redis:6379

JWT_SECRET=local_docker_risklens_secret_change_me_32_chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=risklens-api
JWT_AUDIENCE=risklens-web
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SAME_SITE=lax

CLIENT_URL=http://localhost:3000
CLIENT_URLS=
SERVER_URL=http://localhost:5000

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

MARKET_DATA_PROVIDER=fallback
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_FALLBACK=fallback

CACHE_TTL_SECONDS=45
CSV_BATCH_SIZE=500
